# App
# Production (Vercel): https://diagnostic.create-nation.com  (no trailing slash)
APP_URL=http://localhost:3000
DEV_BYPASS_PAYMENT=true

# Claude (only report generator)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe (optional for local when DEV_BYPASS_PAYMENT=true)
# Checkout uses server-side Sessions only — no browser Stripe.js / publishable key needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID from Stripe product "Create Nation Diagnostics" (price_…)
STRIPE_PRICE_ID=
# Optional reference only (not read by the app). Prefer leaving unset in Vercel.
# STRIPE_PUBLISHABLE_KEY=

# Durable store for Vercel (Upstash Redis / Vercel KV) — required in production
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_EMAIL_FROM=
GHL_WEBHOOK_URL=
GHL_CUSTOM_FIELD_IDS=
GHL_BOOKING_URL=https://create-nation.com/#contact
# Pipeline opportunity sync (Opportunities → create pipeline, then paste IDs)
GHL_PIPELINE_ID=
# Pipeline stages (opportunity moves through these):
# Form submit → NEW_LEAD → (pay+quiz+report) → REPORT_READY → (book CTA) → BOOK_CALL
GHL_STAGE_NEW_LEAD=
GHL_STAGE_REPORT_READY=
GHL_STAGE_BOOK_CALL=
GHL_STAGE_NURTURE=
# Optional lock for /api/ghl/pipelines helper
SETUP_SECRET=

# ─── Marketing / analytics (all optional; leave blank to disable) ───
# Prefer GTM as the hub — add Meta, GA4, Google Ads, TikTok, LinkedIn inside GTM.
NEXT_PUBLIC_GTM_ID=GTM-K53HDXHB
# Or load natively (also works alongside GTM for direct events from the app):
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels from Google Ads (AW-XXXXXXX/AbCDeFgHiJk)
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOK_CALL_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
