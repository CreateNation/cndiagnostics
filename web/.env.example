# App
APP_URL=http://localhost:3000
DEV_BYPASS_PAYMENT=true

# Claude (only report generator)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe (optional for local when DEV_BYPASS_PAYMENT=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GoHighLevel
# Private Integration / Location API token + Location ID (Settings → Business Profile)
GHL_API_KEY=
GHL_LOCATION_ID=
# Verified sending address in the GHL sub-account (required to email reports via API)
GHL_EMAIL_FROM=
# Optional: inbound webhook URL so workflows can react to purchase/report events
GHL_WEBHOOK_URL=
# Optional: map custom field keys → GHL field IDs if key-based upsert fails
# Example: {"cnm_diag_stage":"abc123","cnm_diag_report_url":"def456"}
GHL_CUSTOM_FIELD_IDS=
GHL_BOOKING_URL=https://create-nation.com/#contact
