{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/quiz/[id]/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/quiz/[id]/regenerate/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/meta-capi-retry",
      "schedule": "*/5 * * * *"
    }
  ]
}
